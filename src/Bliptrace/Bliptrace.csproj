<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <PackageId>Bliptrace</PackageId>
    <Version>1.0.0</Version>
    <Authors>Developers Hub Sdn Bhd</Authors>
    <Company>Developers Hub Sdn Bhd</Company>
    <Description>Runtime .NET SDK for Bliptrace — builds a language-neutral error envelope and ships it to the Bliptrace ingest API. Never throws into the host app.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/bliptrace/bliptrace-dotnet</RepositoryUrl>
    <PackageTags>bliptrace;error-tracking;observability;telemetry</PackageTags>
  </PropertyGroup>

</Project>
